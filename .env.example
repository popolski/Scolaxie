# Exemples fictifs. Définir ces variables dans le serveur PHP/Apache local ; ce fichier n'est pas chargé automatiquement.
SCOLAXIE_DB_HOST=example.invalid
SCOLAXIE_DB_PORT=3306
SCOLAXIE_DB_NAME=scolaxie_demo
SCOLAXIE_DB_USER=example_user
SCOLAXIE_DB_PASSWORD=REPLACE_WITH_LOCAL_SECRET
SCOLAXIE_SSO_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET
SCOLAXIE_CLASS_OPTIONS_JSON=[{"id":101,"label":"Classe de démonstration"}]
SCOLAXIE_FASTGAMES_MODE=all
SCOLAXIE_PREVIEW_TEACHER_ID=101
SCOLAXIE_EDITOR_TEACHER_ID=101
# Facultatif pour certaines classes PDF ; ne suffit pas aux parcours PDF incomplets.
SCOLAXIE_TFPDF_DIR=REPLACE_WITH_LOCAL_TFPDF_DIRECTORY
